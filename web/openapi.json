          "url": {
            "type": "string",
            "title": "Url"
          },
          "collections": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Collections"
          },
          "mirror": {
            "type": "string",
            "title": "Mirror"
          },
          "licence": {
            "type": "string",
            "title": "Licence"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "name",
          "kind",
          "url",
          "collections",
          "mirror",
          "licence",
          "description"
