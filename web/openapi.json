            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "name",
          "titiler_url",
          "auth_enabled",
          "sources"
        ],
        "title": "ClientConfig"
      },
      "EtlOut": {
